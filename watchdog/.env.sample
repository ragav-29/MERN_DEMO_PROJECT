# Alert settings
ALERT_METHOD=slack   # options: slack | email
SLACK_WEBHOOK=https://hooks.slack.com/services/XXXX/YYYY/ZZZZ

# or email fallback
# ALERT_METHOD=email
# EMAIL_USER=youremail@gmail.com
# EMAIL_PASS=your-app-password
# EMAIL_TO=recipient@example.com

# Watchdog settings
CHECK_INTERVAL=30
AUTO_REBUILD=true
CRITICAL_SERVICES=mongo,backend,frontend,nginx-proxy
HISTORY_FILE=uptime_history.json
